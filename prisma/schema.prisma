datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("MIRROR_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
  STORE_OWNER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(60)
  email     String   @unique @db.VarChar(191)
  password  String   @db.VarChar(255)
  address   String   @db.VarChar(400)
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Store owner relationship
  store     Store?   @relation("StoreOwner")

  // Ratings submitted by normal users
  ratings   Rating[]

  @@map("users")
}

model Store {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(60)
  email     String   @db.VarChar(191)
  address   String   @db.VarChar(400)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Associated Store Owner
  ownerId   Int?     @unique
  owner     User?    @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Ratings for this store
  ratings   Rating[]

  @@map("stores")
}

model Rating {
  id        Int      @id @default(autoincrement())
  rating    Int      // 1 to 5
  userId    Int
  storeId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
  @@map("ratings")
}
